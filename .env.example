# Kopieer naar .env en vul in. Nooit committen.

# Geheime sleutel voor de sessiecookie (bijv. `openssl rand -hex 32`).
SYNOPTIKON_SECRET_KEY=

# Wachtwoord als scrypt-hash. Maken met:
#   docker compose run --rm app synoptikon hash-password
SYNOPTIKON_PASSWORD_HASH=

# password (standaard) of none (achter nginx basic auth).
SYNOPTIKON_AUTH_MODE=password

# Cookie alleen over HTTPS versturen (1 achter nginx met TLS, 0 lokaal).
SYNOPTIKON_COOKIE_SECURE=1

# Geldigheid van een sessie in dagen.
SYNOPTIKON_SESSION_DAYS=30

# Aanmelden met een uitnodigingscode (/aanmelden): wie de code heeft, maakt zelf een account (rol lezer) en kan
# leerlijsten delen, liken, erop reageren en ze overnemen (/gedeeld). Leeg = aanmelden staat uit.
SYNOPTIKON_AANMELDCODE=

# Koppeling met Wunderkammer (alleen lezen): token van minstens 24 tekens, bijv. `openssl rand -hex 24`.
# Hetzelfde token in Wunderkammer als WK_SYNOPTIKON_TOKEN. Leeg = uit.
SYNOPTIKON_WK_TOKEN=

# Eén aanmelding met Wunderkammer (synoptikon/sso.py): gedeeld geheim van minstens 32 tekens (openssl rand -hex 32),
# hetzelfde als WK_SSO_SECRET, en het domein voor de cookie. Leeg = uit.
SYNOPTIKON_SSO_SECRET=
SYNOPTIKON_SSO_DOMEIN=.regoort.me

# Kaarten uit notities (synoptikon notities, scripts/notities.sh): per map in de notities het vak in Wunderkammer.
# Mappen zonder vak worden overgeslagen; een notitie kan het vak ook zelf zetten (frontmatter `vak:`). Leeg = uit.
SYNOPTIKON_NOTITIES_VAKKEN=Zivilrecht 1A=ZR Ia; Europäisches Gesellschaftsrecht=GÖ; Kapitalmarktrecht=W

# Claude: opzoeken (/opzoeken) en onderzoek bij een vraag. Leeg = die twee functies staan uit.
SYNOPTIKON_ANTHROPIC_API_KEY=
SYNOPTIKON_CLAUDE_MODEL=claude-opus-5-5
# Harde grens per kalendermaand, in dollar.
SYNOPTIKON_LLM_BUDGET_USD=20

# Standaardtaal voor vertalingen in de synopse.
SYNOPTIKON_UI_LANG=nl

# Légifrance / PISTE. Leeg laten zolang je geen sleutel hebt; de importer slaat dan over.
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
LEGIFRANCE_SANDBOX=0
